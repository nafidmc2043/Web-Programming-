</head>
<style>
img{
 margin-left:400px;
 margin-top:200px;
 border-radius:50%;
 }
</style>
<body>

    <img src ="car.jpeg" id = "image" onmouseover="one()" onmouseout ="two()">
    <p id ="p1">
    </p>

<script>
    function one()
    {
      document.getElementById("image").src="car2.jpeg";
      document.getElementById("p1").innerHTML="onmouseover";
      document.getElementById("p1").style.color="red";
    }
    
    function two()
    {
      document.getElementById("image").src="car3.jpeg";
      document.getElementById("p1").innerHTML="onmouseout";
      document.getElementById("p1").style.color="blue";
    }
      
</script>



</body>
</html>
